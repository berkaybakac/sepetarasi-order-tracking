PORT=3000
DB_PATH=./data/sepetarasi.db
STORE_TIMEZONE=Europe/Istanbul
ANNOUNCEMENTS_PATH=./packages/server/assets/announcements
DISABLE_AUDIO=false
ENABLE_TTS_FALLBACK=false
# WebSocket Auth: WS_AUTH_KEY (server) and VITE_WS_AUTH_KEY (clients) must match perfectly.
WS_AUTH_KEY=dev-ws-auth-key
VITE_WS_AUTH_KEY=dev-ws-auth-key
# HTTP (LAN/Pi4) için false, HTTPS için true önerilir.
COOKIE_SECURE=false

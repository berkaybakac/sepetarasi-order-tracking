{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"if": "Bash(git commit*)",
						"command": "npm run lint && npm run typecheck",
						"timeout": 60,
						"statusMessage": "lint + typecheck kontrol ediliyor..."
					}
				]
			}
		]
	}
}

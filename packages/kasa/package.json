{
	"name": "@sepetarasi/kasa",
	"version": "0.1.0",
	"description": "Sepetarasi Order Tracking Kasa Application",
	"author": "Berkay Bakac",
	"private": true,
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "env -u ELECTRON_RUN_AS_NODE vite",
		"build": "tsc && vite build && electron-builder",
		"build:win": "tsc && vite build && electron-builder --win --x64",
		"build:mac": "tsc && vite build && electron-builder --mac",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"test": "vitest run",
		"test:unit": "vitest run tests/orderStore.test.ts tests/discovery.test.ts tests/orderForm.test.tsx tests/printer.test.ts",
		"test:integration": "echo 'No integration tests for kasa yet' && exit 0"
	},
	"dependencies": {
		"@sepetarasi/shared": "*",
		"@tailwindcss/vite": "^4.2.2",
		"iconv-lite": "^0.6.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwindcss": "^4.2.2",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.4.0",
		"electron": "35.7.5",
		"electron-builder": "^25.1.0",
		"jsdom": "^27.0.1",
		"typescript": "^5.7.0",
		"vite": "^6.3.0",
		"vite-plugin-electron": "^0.28.0",
		"vite-plugin-electron-renderer": "^0.14.0"
	},
	"build": {
		"appId": "com.sepetarasi.kasa",
		"productName": "Sepetarasi Kasa",
		"directories": {
			"output": "release"
		},
		"win": {
			"target": "nsis",
			"icon": "build/icon.png"
		},
		"nsis": {
			"oneClick": true,
			"allowToChangeInstallationDirectory": false
		},
		"mac": {
			"target": "dmg",
			"icon": "build/icon.png"
		}
	}
}

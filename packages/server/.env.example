PORT=3000
DB_PATH=./data/sepetarasi.db
STORE_TIMEZONE=Europe/Istanbul

# Zorunlu — production'da güçlü değerlerle değiştir
JWT_SECRET=dev-secret-sabit
COOKIE_SECRET=dev-cookie-sabit
CASHIER_TOKEN=local-dev-cashier-token
WS_AUTH_KEY=dev-ws-auth-key        # packages/kasa/.env içindeki VITE_WS_AUTH_KEY ile aynı olmalı
# HTTP (LAN/Pi4) için false, HTTPS için true önerilir.
COOKIE_SECURE=false

# Pi4 ses ayarları (Mac'te gerek yok)
# Pi4'te önce: sudo apt install mpg123
AUDIO_ALSA_DEVICE=hw:2,0
DISABLE_AUDIO=false
ENABLE_TTS_FALLBACK=false
ANNOUNCEMENTS_PATH=./packages/server/assets/announcements

# Müzik dosyaları dizini (varsayılan: packages/server/assets/music)
# .gitignore'a alındı — yüklenen MP3'ler repoya girmez
MUSIC_PATH=./packages/server/assets/music

# Opsiyonel
LOG_PATH=./data/app.log

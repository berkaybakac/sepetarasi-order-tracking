{
	"name": "@sepetarasi/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/server.js",
	"scripts": {
		"dev": "pkill -f 'tsx watch src/server' 2>/dev/null; tsx watch --env-file=.env src/server.ts",
		"build": "tsc && rm -rf dist/db/migrations && mkdir -p dist/db/migrations && cp -r src/db/migrations/. dist/db/migrations/",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:seed": "tsx src/db/seed.ts",
		"db:reset-password": "tsx scripts/reset-password.ts",
		"db:migrate-music-paths": "tsx scripts/migrate-music-paths.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/jwt": "^10.0.0",
		"@fastify/multipart": "^10.0.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/static": "^9.0.0",
		"@fastify/websocket": "^11.0.0",
		"@sepetarasi/shared": "*",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^11.7.0",
		"drizzle-orm": "^0.39.0",
		"fastify": "^5.2.0"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^7.6.0",
		"@types/node": "^22.0.0",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^3.2.4",
		"drizzle-kit": "^0.30.0",
		"tsx": "^4.19.0",
		"vitest": "^3.1.0"
	}
}
